# D2 copies a D2 class name into the SVG class attribute, so node A's group
# comes out as class="<id> appendix-icon" around an off-palette fill. Node C
# carries a real link, so D2 also draws one real icon later in the same SVG.
# The gate must ignore that one real icon and never a shape that borrows its
# class name, including by matching from A's group on to the real icon's end.
# icons: 1
# expect: fill=#ff0000
classes: {
  appendix-icon: {
    style.fill: "#ff0000"
  }
}
A: Create template
A.class: appendix-icon
B: Launch process
C: Track progress {
  link: /products/pro/tracking-and-tasks/tracker-view/
}

A -> B
B -> C
